# Database URL for PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/mydb"
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # Generate a secret key: `pnpm dlx @better-auth/cli secret`

POSTGRES_USER=capagla
POSTGRES_PASSWORD=postgres
POSTGRES_DB=capagla
POSTGRES_PORT=4324

BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=
BUNNY_API_KEY=
BUNNY_TOKEN_KEY=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
BUNNY_STORAGE_HOST=
BUNNY_STORAGE_CDN_URL=
STRIPE_PUBLISH_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Brevo (correo). Sin clave o sin remitente, los correos solo salen en la consola del servidor.
# El remitente debe ser de un dominio verificado en Brevo (Remitentes y dominios).
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Capagla
# Buzón que recibe los reportes de "Ayuda y reportar un fallo" y las respuestas a los correos.
SUPPORT_EMAIL=soporte@capagla.com

# Solo para el seed (`pnpm prisma db seed`) con una base que NO es local (producción): la
# administradora del panel. Sin ellas, el seed se niega a crearla. Contraseña de 12+ caracteres.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Asistente de IA de las preguntas (Claude). Sin clave no hay asistente: las preguntas van directo
# a la chef. El modelo es siempre Claude Haiku 5.5: no se configura.
# ANTHROPIC_API_KEY=
# Solo si Anthropic responde 400 "not scoped to a workspace" (clave atada a un usuario):
# ANTHROPIC_WORKSPACE_ID=
