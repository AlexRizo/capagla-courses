generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  STUDENT
}

model User {
  id              String           @id
  name            String
  email           String
  emailVerified   Boolean          @default(false)
  image           String?
  role            Role             @default(STUDENT)
  // Cuenta suspendida desde el panel: no puede entrar ni conserva sesiones.
  suspendedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  accounts        Account[]
  orders          Order[]
  enrollments     Enrollment[]
  lessonProgress  LessonProgress[]
  lessonMoments   LessonMoment[]
  questions       LessonQuestion[]
  lead            Lead?
  costPlaces      CostPlace[]
  costIngredients CostIngredient[]
  costSettings    CostSettings?
  costTags        CostTag[]
  costPremixes    CostPremix[]
  costRecipes     CostRecipe[]
  costProducts    CostProduct[]
  costProductions CostProduction[]
  costLists       CostList[]
  costPurchases   CostPurchase[]
  costQuotes      CostQuote[]
  assistantUsage  AssistantUsage[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum ProductKind {
  COURSE
  TOOL
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  // Reembolsada por completo: se quitó el acceso a lo que incluía.
  REFUNDED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum ItemKind {
  BLOCK
  CHAPTER
  LESSON
}

enum QuestionStatus {
  // Solo la contestó el asistente de IA: la alumna aún no se la manda a la chef.
  ASSISTANT
  PENDING
  ANSWERED
  HIDDEN
}

enum QuestionVote {
  UP
  DOWN
}

enum LessonType {
  VIDEO
  TEXT
}

model Product {
  id          String             @id @default(cuid())
  slug        String             @unique
  name        String
  kind        ProductKind
  priceMxn    Int
  // Descripción corta y portada: se ven en la tarjeta del producto (Home).
  description String?
  coverUrl    String?
  accessDays  Int                @default(365)
  // Borrador = no es público: no sale en la Home, su landing da 404 y no se vende.
  status      ContentStatus      @default(DRAFT)
  // Orden en que se muestran los productos en la Home (de menor a mayor).
  position    Int                @default(0)
  orderItems  OrderItem[]
  enrollments Enrollment[]
  items       CourseItem[]
  promotions  PromotionProduct[]
}

// Promoción (modo pro): una landing con URL propia (`/navidad`) que vende un curso
// principal y hasta 2 adicionales con precio especial. Los precios especiales solo
// aplican dentro de `startsAt`–`endsAt` (zona America/Mexico_City); sin fecha de inicio
// no empieza y sin fecha de fin no termina.
model Promotion {
  id           String             @id @default(cuid())
  // Parte de la URL sin "/": `navidad` → `/navidad`.
  slug         String             @unique
  name         String
  startsAt     DateTime?
  endsAt       DateTime?
  introTitle   String?
  introText    String?
  // Video de intro de la landing: id del video en la biblioteca de Bunny (antes una URL).
  introVideoId String?
  paused       Boolean            @default(false)
  createdAt    DateTime           @default(now())
  products     PromotionProduct[]
  orders       Order[]
  events       PromotionEvent[]
}

enum PromotionEventKind {
  VISIT
  CART
}

// Medición de una promoción: cuántos navegadores distintos (`visitorId`, cookie anónima)
// vieron su landing (VISIT) o llegaron al pago con ella (CART). Una fila por navegador y
// tipo: recargar o volver no suma.
model PromotionEvent {
  id          String             @id @default(cuid())
  createdAt   DateTime           @default(now())
  promotionId String
  promotion   Promotion          @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  kind        PromotionEventKind
  visitorId   String

  @@unique([promotionId, kind, visitorId])
}

// Producto de una promoción. `position` 0 = curso principal; 1 y 2 = adicionales.
// `priceMxn` es el precio especial (0 = regalo).
model PromotionProduct {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  position    Int
  priceMxn    Int

  @@unique([promotionId, productId])
}

// Árbol del curso en una sola tabla: Bloque > Capítulo | Lección, y Capítulo > Lección.
// Capítulo y lección se convierten entre sí cambiando `kind`; las reglas de
// anidación (qué cuelga de qué) las valida la aplicación, no la base.
model CourseItem {
  id           String            @id @default(cuid())
  productId    String
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       CourseItem?       @relation("ItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     CourseItem[]      @relation("ItemTree")
  kind         ItemKind
  position     Int
  title        String
  // Hoy no se gestiona por elemento: lo público o borrador es el curso (`Product.status`).
  status       ContentStatus     @default(PUBLISHED)
  // Bloque o capítulo: visible sin comprar (con todo lo que contiene) para quien se registre
  // con su correo (origen de los leads). Una lección no es gratis por sí sola.
  isFree       Boolean           @default(false)
  // Capítulo: receta compartida por todas sus lecciones. Texto enriquecido (JSON de Tiptap).
  recipe       Json?
  // Lección.
  lessonType   LessonType?
  // Lección tipo TEXT (receta): texto enriquecido (JSON de Tiptap).
  body         Json?
  videoUrl     String?
  // Video en Bunny Stream (GUID). Si existe, manda sobre `videoUrl`: la reproducción va firmada.
  bunnyVideoId String?
  durationSec  Int?
  notes        String?
  // Una parte por línea: "2:10 Derretir el chocolate".
  videoParts   String?
  resources    Resource[]
  progress     LessonProgress[]
  moments      LessonMoment[]
  questions    LessonQuestion[]
  transcript   LessonTranscript?

  @@index([productId, parentId, position])
}

// Lecciones que una alumna marcó como vistas (botón "Marcar como vista"). Si existe la fila, está vista.
model LessonProgress {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  item      CourseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

// "Mis momentos": marcadores que una alumna pone en el video de una lección (minuto y nombre).
model LessonMoment {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  item      CourseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  seconds   Int
  name      String

  @@index([userId, itemId])
}

// Quien se registró con su correo en "Clase gratis": ve los bloques gratis de los cursos sin comprar.
// Guarda cuándo aceptó el aviso de privacidad y recibir correos (el permiso no se pierde si luego compra).
model Lead {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  email            String   @unique
  consentAt        DateTime
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Atribución con la que llegó y si aceptó las cookies de medición (ver `Order`).
  attribution      Json?
  marketingConsent Boolean?
}

// Datos de conexión de Marketing (una sola fila, id "main"). Solo se guardan: ningún píxel ni
// evento se envía todavía a Meta, TikTok o Google Analytics.
model MarketingSettings {
  id               String   @id @default("main")
  updatedAt        DateTime @updatedAt
  metaPixelId      String   @default("")
  metaToken        String   @default("")
  metaTestCode     String   @default("")
  tiktokPixelId    String   @default("")
  tiktokToken      String   @default("")
  tiktokTestCode   String   @default("")
  ga4MeasurementId String   @default("")
}

// Transcripción de una lección: `lines` es una lista [{ t: segundos, x: texto }]. La usa el
// asistente de IA y la pestaña "Lección y transcripción" del panel.
model LessonTranscript {
  itemId    String     @id
  item      CourseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  updatedAt DateTime   @updatedAt
  lines     Json
}

// Ajustes del asistente de IA (una sola fila, id "main").
model AssistantSettings {
  id         String  @id @default("main")
  // Máximo de caracteres por respuesta del asistente.
  maxChars   Int     @default(600)
  // Interruptor para las alumnas: apagado, "Preguntar" va directo a la chef.
  enabled    Boolean @default(true)
  // Tope global: preguntas al asistente en 24 horas, sumando a todas las alumnas.
  dailyLimit Int     @default(2000)
}

enum AssistantOutcome {
  // Reservada: el modelo aún no responde (o el servidor se cayó antes de terminar).
  RESERVED
  OK
  // El modelo se negó a responder.
  REFUSED
  // Falló la llamada: no cuenta para el tope diario, sí para el límite por minuto.
  FAILED
}

// Una fila por pregunta de una alumna al asistente, creada ANTES de llamar al modelo: así los
// límites cuentan también las peticiones simultáneas y los fallos, y queda lo que se gastó.
model AssistantUsage {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId       String
  outcome      AssistantOutcome @default(RESERVED)
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Pregunta de una alumna a la chef sobre una lección. Mientras está PENDING solo la ve ella;
// al publicar la respuesta (ANSWERED) queda visible para todas las alumnas del curso;
// HIDDEN la saca de la lección sin borrarla.
model LessonQuestion {
  id              String         @id @default(cuid())
  createdAt       DateTime       @default(now())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId          String
  item            CourseItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  text            String
  status          QuestionStatus @default(PENDING)
  answer          String?
  answeredAt      DateTime?
  // Lo que respondió el asistente (no se publica) y si le sirvió a la alumna.
  assistantAnswer String?
  vote            QuestionVote?
  // Borrador de la IA para la chef; se genera al abrir la pregunta y se puede regenerar.
  draft           String?

  @@index([itemId, status])
  @@index([status, createdAt])
}

// Archivos de un capítulo o una lección. La subida real está pendiente (UploadThing).
model Resource {
  id       String     @id @default(cuid())
  itemId   String
  item     CourseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name     String
  url      String
  position Int
}

// La orden guarda nombre y correo porque el usuario no existe hasta que se paga.
// amountMxn es el total; cada producto (curso, bono, herramienta) va en un item.
model Order {
  id                    String      @id @default(cuid())
  email                 String
  name                  String
  status                OrderStatus @default(PENDING)
  amountMxn             Int
  createdAt             DateTime    @default(now())
  paidAt                DateTime?
  refundedAt            DateTime?
  items                 OrderItem[]
  userId                String?
  user                  User?       @relation(fields: [userId], references: [id])
  // Promoción desde la que llegó la compra (atribución); null si fue por un enlace simple.
  promotionId           String?
  promotion             Promotion?  @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  // PaymentIntent de Stripe con el que se cobra la orden.
  stripePaymentIntentId String?     @unique
  // Renovación del acceso desde Mis cursos (precio de renovación, sin adicionales).
  renewal               Boolean     @default(false)
  // Atribución de marketing al comprar (utm_*, fbclid, ttclid, página de entrada) y si la persona
  // aceptó las cookies de medición en ese momento (null = no había elegido). Ver lib/attribution.ts.
  attribution           Json?
  marketingConsent      Boolean?
  // IP, navegador y cookies del píxel (fbp, fbc) del momento del pago: el servidor los manda con
  // el evento Purchase aunque la compra la confirme el webhook de Stripe. Solo si aceptó las
  // cookies de medición. Ver lib/track-core.ts.
  trackingContext       Json?

  @@index([email])
  @@index([promotionId])
}

model OrderItem {
  id        String  @id @default(cuid())
  amountMxn Int
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
}

model Enrollment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

// --- Herramienta de costos (cada alumna con acceso tiene sus propios datos) ---

enum CostItemKind {
  INGREDIENT
  PACKAGING
}

// Unidad en que se compra: g y kg (peso), ml y l (volumen), pza (pieza).
enum CostUnit {
  G
  KG
  ML
  L
  PZA
}

// Tienda o proveedor. Un ingrediente sin lugar cae en "Sin lugar asignado" en la lista de compra.
model CostPlace {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  note          String?
  createdAt     DateTime         @default(now())
  ingredients   CostIngredient[]
  costPurchases CostPurchase[]

  @@index([userId])
}

// Ingrediente o empaque: lo que se compra. El costo por gramo, mililitro o pieza se calcula
// al vuelo (lib/costs.ts); solo se guardan el precio y la cantidad de compra.
model CostIngredient {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  kind         CostItemKind @default(INGREDIENT)
  placeId      String?
  place        CostPlace?   @relation(fields: [placeId], references: [id], onDelete: SetNull)
  price        Decimal      @db.Decimal(12, 2)
  quantity     Decimal      @db.Decimal(14, 3)
  unit         CostUnit
  // Uso flexible (solo piezas): se pesaron `sampleCount` piezas y pesaron `sampleGrams` g en total.
  flexible     Boolean      @default(false)
  sampleCount  Int?
  sampleGrams  Decimal?     @db.Decimal(14, 3)
  // Desperdicio: porcentaje que se aprovecha (1 a 99).
  wasteEnabled Boolean      @default(false)
  yieldPct     Int?
  // Archivar en vez de borrar: lo que ya lo usa sigue funcionando.
  archivedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  premixLines   CostPremixLine[]
  recipeLines   CostRecipeLine[]
  packaging     CostProductPackaging[]
  listEntries   CostListEntry[]
  purchaseItems CostPurchaseItem[]

  @@index([userId, archivedAt])
  @@index([placeId])
}

// Cómo se calcula la mano de obra por hora: lo que se quiere ganar al mes, el salario mínimo
// diario entre 8 horas, o no sumarla.
enum CostLaborMode {
  WANTED
  MINIMUM_WAGE
  NONE
}

// Sobre qué costo se aplica el múltiplo del precio.
enum CostPriceBase {
  TOTAL
  INGREDIENTS
}

// Ajustes de costos de una alumna: se escriben una sola vez y se usan en todas sus recetas. Todo
// lo que se calcula (gasto fijo por hora, mano de obra por hora) sale al vuelo de estos datos
// (lib/cost-settings.ts); aquí solo se guarda lo que ella escribe.
model CostSettings {
  userId          String        @id
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Tus horas
  hoursPerWeek    Decimal?      @db.Decimal(6, 2)
  // Gasto fijo por hora: luz, gas, renta y depreciación del horno
  ovenKw          Decimal?      @db.Decimal(8, 3)
  kwhPrice        Decimal?      @db.Decimal(10, 3)
  gasKgPerHour    Decimal?      @db.Decimal(8, 3)
  gasPricePerKg   Decimal?      @db.Decimal(10, 2)
  rentMonthly     Decimal?      @db.Decimal(12, 2)
  rentSharePct    Decimal?      @db.Decimal(5, 2)
  equipCost       Decimal?      @db.Decimal(12, 2)
  equipLifeHours  Decimal?      @db.Decimal(12, 2)
  // Mano de obra por hora
  laborMode       CostLaborMode @default(WANTED)
  wantedMonthly   Decimal?      @db.Decimal(12, 2)
  dailyMinWage    Decimal?      @db.Decimal(10, 2)
  // Cómo se fija el precio: vender a N veces el costo (un múltiplo, no un porcentaje)
  multiplier      Decimal?      @db.Decimal(6, 2)
  defaultWastePct Decimal?      @db.Decimal(5, 2)
  priceBase       CostPriceBase @default(TOTAL)
  // Impuestos, solo si vende como negocio
  sellsAsBusiness Boolean       @default(false)
  taxPct          Decimal?      @db.Decimal(5, 2)
  updatedAt       DateTime      @updatedAt
}

// Etiqueta de receta (Pastel, Cupcake, Galleta…): solo sirve para clasificar y filtrar. Se escribe
// al crear la receta y se sugieren las que ya existen; una en uso no se borra, se archiva.
model CostTag {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  recipes    CostRecipe[]

  @@unique([userId, name])
}

// Premezcla: una sub-receta que se prepara una vez y se usa en varias recetas (un betún, un
// relleno). Se cuesta por lo que de verdad rinde (peso o volumen que le quedó).
model CostPremix {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  yieldQty   Decimal?         @db.Decimal(14, 3)
  yieldUnit  CostUnit         @default(G)
  archivedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  lines      CostPremixLine[]
  usedBy     CostRecipeLine[]

  @@index([userId, archivedAt])
}

model CostPremixLine {
  id           String         @id @default(cuid())
  premixId     String
  premix       CostPremix     @relation(fields: [premixId], references: [id], onDelete: Cascade)
  position     Int
  ingredientId String
  ingredient   CostIngredient @relation(fields: [ingredientId], references: [id])
  quantity     Decimal        @db.Decimal(14, 3)
  unit         CostUnit

  @@index([premixId])
  @@index([ingredientId])
}

// Receta: una tanda (un pastel, una charola, una docena). Lleva su costo (ingredientes, merma,
// mano de obra y gasto fijo) pero no precio ni empaque: eso vive en el producto. El rendimiento
// siempre es en piezas y los nombres pueden repetirse (se distinguen por etiqueta).
model CostRecipe {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  tagId        String?
  tag          CostTag?            @relation(fields: [tagId], references: [id], onDelete: SetNull)
  yieldPieces  Int?
  laborHours   Decimal?            @db.Decimal(8, 2)
  ovenHours    Decimal?            @db.Decimal(8, 2)
  includeLabor Boolean             @default(true)
  includeFixed Boolean             @default(true)
  includeWaste Boolean             @default(true)
  wastePct     Decimal?            @db.Decimal(5, 2)
  archivedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  lines        CostRecipeLine[]
  inProducts   CostProductRecipe[]

  @@index([userId, archivedAt])
  @@index([tagId])
}

// Un renglón de la receta: un ingrediente o una premezcla (uno de los dos), con su cantidad.
model CostRecipeLine {
  id           String          @id @default(cuid())
  recipeId     String
  recipe       CostRecipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  position     Int
  ingredientId String?
  ingredient   CostIngredient? @relation(fields: [ingredientId], references: [id])
  premixId     String?
  premix       CostPremix?     @relation(fields: [premixId], references: [id])
  quantity     Decimal         @db.Decimal(14, 3)
  unit         CostUnit

  @@index([recipeId])
  @@index([ingredientId])
  @@index([premixId])
}

// Dónde va el empaque de un producto: la pieza entera o cada rebanada.
enum CostPackagingScope {
  WHOLE
  SLICE
}

// Producto: lo que se vende. Junta una o varias recetas más el empaque del entero y es donde viven
// el precio y el semáforo. Opcionalmente también se vende por rebanadas (costo del entero ÷ N, más
// el empaque de cada rebanada). Costos y márgenes se calculan al vuelo (lib/cost-product.ts).
model CostProduct {
  id             String                 @id @default(cuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  price          Decimal?               @db.Decimal(12, 2)
  sellsSlices    Boolean                @default(false)
  slicesPerPiece Int?
  slicePrice     Decimal?               @db.Decimal(12, 2)
  // Suma el impuesto de Ajustes al precio sugerido.
  withTax        Boolean                @default(false)
  archivedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  recipes        CostProductRecipe[]
  packaging      CostProductPackaging[]
  inProductions  CostProductionItem[]
  inQuotes       CostQuote[]

  @@index([userId, archivedAt])
}

// Una receta del producto y cuántas de sus piezas salieron para vender (por defecto, lo que rinde).
model CostProductRecipe {
  id         String      @id @default(cuid())
  productId  String
  product    CostProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  position   Int
  recipeId   String
  recipe     CostRecipe  @relation(fields: [recipeId], references: [id])
  piecesSold Int

  @@index([productId])
  @@index([recipeId])
}

model CostProductPackaging {
  id           String             @id @default(cuid())
  productId    String
  product      CostProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  scope        CostPackagingScope
  position     Int
  ingredientId String
  ingredient   CostIngredient     @relation(fields: [ingredientId], references: [id])
  quantity     Decimal            @db.Decimal(14, 3)
  unit         CostUnit

  @@index([productId])
  @@index([ingredientId])
}

// Producción: lo que ya se sabe que se va a hornear (productos y cuántos). De ahí salen su lista de
// compra y su utilidad esperada; todo se recalcula con los costos del momento. Se guarda 30 días
// desde el último guardado y después se limpia.
model CostProduction {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  expiresAt DateTime
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  items     CostProductionItem[]
  list      CostList?

  @@index([userId, expiresAt])
}

model CostProductionItem {
  id           String         @id @default(cuid())
  productionId String
  production   CostProduction @relation(fields: [productionId], references: [id], onDelete: Cascade)
  position     Int
  productId    String
  product      CostProduct    @relation(fields: [productId], references: [id])
  quantity     Int

  @@index([productionId])
  @@index([productId])
}

// Lista de compra: una por producción, más una "directa" por alumna (sin producción) para lo que
// se agrega a mano. Lo que hay que comprar se calcula de la producción; aquí solo se guarda lo
// que la alumna decide: el orden, el lugar de hoy, "Ya lo tengo", lo comprado y lo agregado a mano.
model CostList {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productionId String?         @unique
  production   CostProduction? @relation(fields: [productionId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  entries      CostListEntry[]

  @@index([userId])
}

model CostListEntry {
  id           String         @id @default(cuid())
  listId       String
  list         CostList       @relation(fields: [listId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   CostIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  position     Int
  // Lugar de compra de hoy: sin valor es el del ingrediente; "none" es "Sin lugar asignado".
  placeKey     String?
  haveIt       Boolean        @default(false)
  bought       Boolean        @default(false)
  // Paquetes completos agregados a mano.
  manualPacks  Int            @default(0)

  @@unique([listId, ingredientId])
}

// Una compra registrada: lo que se pagó en una tienda un día. Al guardarla, el precio de cada
// ingrediente se actualiza al que se pagó y se conserva el anterior para ver cuánto cambió.
model CostPurchase {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId   String?
  place     CostPlace?         @relation(fields: [placeId], references: [id], onDelete: SetNull)
  date      DateTime           @db.Date
  createdAt DateTime           @default(now())
  items     CostPurchaseItem[]

  @@index([userId, date])
}

model CostPurchaseItem {
  id            String         @id @default(cuid())
  purchaseId    String
  purchase      CostPurchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredientId  String
  ingredient    CostIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  // Lo que costaba antes de esta compra y lo que se pagó (por el paquete que vende la tienda).
  previousPrice Decimal        @db.Decimal(12, 2)
  price         Decimal        @db.Decimal(12, 2)
  // Lo que pesó el paquete completo (solo en lo que se compra por pieza), opcional.
  packGrams     Decimal?       @db.Decimal(14, 3)

  @@index([purchaseId])
  @@index([ingredientId])
}

// Cotizador: un pedido a partir de un producto. Solo guarda lo que se capturó (producto, cantidad,
// horas extra y extras); el mínimo a cobrar se recalcula con los costos de hoy y el producto no se toca.
model CostQuote {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String
  product       CostProduct      @relation(fields: [productId], references: [id])
  quantity      Int
  // Horas extra de decorado y para conseguir los insumos extra.
  decorHours    Decimal          @default(0) @db.Decimal(7, 2)
  sourcingHours Decimal          @default(0) @db.Decimal(7, 2)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  extras        CostQuoteExtra[]

  @@index([userId, updatedAt])
  @@index([productId])
}

model CostQuoteExtra {
  id       String    @id @default(cuid())
  quoteId  String
  quote    CostQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position Int
  name     String
  cost     Decimal   @db.Decimal(12, 2)

  @@index([quoteId])
}
