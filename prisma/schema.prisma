generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  STUDENT
}

model User {
  id             String           @id
  name           String
  email          String
  emailVerified  Boolean          @default(false)
  image          String?
  role           Role             @default(STUDENT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sessions       Session[]
  accounts       Account[]
  orders         Order[]
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  lessonMoments  LessonMoment[]
  questions      LessonQuestion[]
  lead           Lead?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum ProductKind {
  COURSE
  TOOL
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  // Reembolsada por completo: se quitó el acceso a lo que incluía.
  REFUNDED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum ItemKind {
  BLOCK
  CHAPTER
  LESSON
}

enum QuestionStatus {
  PENDING
  ANSWERED
  HIDDEN
}

enum LessonType {
  VIDEO
  TEXT
}

model Product {
  id          String             @id @default(cuid())
  slug        String             @unique
  name        String
  kind        ProductKind
  priceMxn    Int
  // Descripción corta y portada: se ven en la tarjeta del producto (Home).
  description String?
  coverUrl    String?
  accessDays  Int                @default(365)
  // Borrador = no es público: no sale en la Home, su landing da 404 y no se vende.
  status      ContentStatus      @default(DRAFT)
  // Orden en que se muestran los productos en la Home (de menor a mayor).
  position    Int                @default(0)
  orderItems  OrderItem[]
  enrollments Enrollment[]
  items       CourseItem[]
  promotions  PromotionProduct[]
}

// Promoción (modo pro): una landing con URL propia (`/navidad`) que vende un curso
// principal y hasta 2 adicionales con precio especial. Los precios especiales solo
// aplican dentro de `startsAt`–`endsAt` (zona America/Mexico_City); sin fecha de inicio
// no empieza y sin fecha de fin no termina.
model Promotion {
  id           String             @id @default(cuid())
  // Parte de la URL sin "/": `navidad` → `/navidad`.
  slug         String             @unique
  name         String
  startsAt     DateTime?
  endsAt       DateTime?
  introTitle   String?
  introText    String?
  // Video de intro de la landing: id del video en la biblioteca de Bunny (antes una URL).
  introVideoId String?
  paused       Boolean            @default(false)
  createdAt    DateTime           @default(now())
  products     PromotionProduct[]
  orders       Order[]
}

// Producto de una promoción. `position` 0 = curso principal; 1 y 2 = adicionales.
// `priceMxn` es el precio especial (0 = regalo).
model PromotionProduct {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  position    Int
  priceMxn    Int

  @@unique([promotionId, productId])
}

// Árbol del curso en una sola tabla: Bloque > Capítulo | Lección, y Capítulo > Lección.
// Capítulo y lección se convierten entre sí cambiando `kind`; las reglas de
// anidación (qué cuelga de qué) las valida la aplicación, no la base.
model CourseItem {
  id           String           @id @default(cuid())
  productId    String
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       CourseItem?      @relation("ItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     CourseItem[]     @relation("ItemTree")
  kind         ItemKind
  position     Int
  title        String
  // Hoy no se gestiona por elemento: lo público o borrador es el curso (`Product.status`).
  status       ContentStatus    @default(PUBLISHED)
  // Bloque: visible sin comprar para quien se registre con su correo (origen de los leads).
  isFree       Boolean          @default(false)
  // Capítulo: receta compartida por todas sus lecciones. Texto enriquecido (JSON de Tiptap).
  recipe       Json?
  // Lección.
  lessonType   LessonType?
  // Lección tipo TEXT (receta): texto enriquecido (JSON de Tiptap).
  body         Json?
  videoUrl     String?
  // Video en Bunny Stream (GUID). Si existe, manda sobre `videoUrl`: la reproducción va firmada.
  bunnyVideoId String?
  durationSec  Int?
  notes        String?
  // Una parte por línea: "2:10 Derretir el chocolate".
  videoParts   String?
  resources    Resource[]
  progress     LessonProgress[]
  moments      LessonMoment[]
  questions    LessonQuestion[]

  @@index([productId, parentId, position])
}

// Lecciones que una alumna marcó como vistas (botón "Marcar como vista"). Si existe la fila, está vista.
model LessonProgress {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  item      CourseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

// "Mis momentos": marcadores que una alumna pone en el video de una lección (minuto y nombre).
model LessonMoment {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  item      CourseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  seconds   Int
  name      String

  @@index([userId, itemId])
}

// Quien se registró con su correo en "Clase gratis": ve los bloques gratis de los cursos sin comprar.
// Guarda cuándo aceptó el aviso de privacidad y recibir correos (el permiso no se pierde si luego compra).
model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  email     String   @unique
  consentAt DateTime
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Datos de conexión de Marketing (una sola fila, id "main"). Solo se guardan: ningún píxel ni
// evento se envía todavía a Meta, TikTok o Google Analytics.
model MarketingSettings {
  id               String   @id @default("main")
  updatedAt        DateTime @updatedAt
  metaPixelId      String   @default("")
  metaToken        String   @default("")
  metaTestCode     String   @default("")
  tiktokPixelId    String   @default("")
  tiktokToken      String   @default("")
  tiktokTestCode   String   @default("")
  ga4MeasurementId String   @default("")
}

// Pregunta de una alumna a la chef sobre una lección. Mientras está PENDING solo la ve ella;
// al publicar la respuesta (ANSWERED) queda visible para todas las alumnas del curso;
// HIDDEN la saca de la lección sin borrarla.
model LessonQuestion {
  id         String         @id @default(cuid())
  createdAt  DateTime       @default(now())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId     String
  item       CourseItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  text       String
  status     QuestionStatus @default(PENDING)
  answer     String?
  answeredAt DateTime?

  @@index([itemId, status])
  @@index([status, createdAt])
}

// Archivos de un capítulo o una lección. La subida real está pendiente (UploadThing).
model Resource {
  id       String     @id @default(cuid())
  itemId   String
  item     CourseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name     String
  url      String
  position Int
}

// La orden guarda nombre y correo porque el usuario no existe hasta que se paga.
// amountMxn es el total; cada producto (curso, bono, herramienta) va en un item.
model Order {
  id                    String      @id @default(cuid())
  email                 String
  name                  String
  status                OrderStatus @default(PENDING)
  amountMxn             Int
  createdAt             DateTime    @default(now())
  paidAt                DateTime?
  refundedAt            DateTime?
  items                 OrderItem[]
  userId                String?
  user                  User?       @relation(fields: [userId], references: [id])
  // Promoción desde la que llegó la compra (atribución); null si fue por un enlace simple.
  promotionId           String?
  promotion             Promotion?  @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  // PaymentIntent de Stripe con el que se cobra la orden.
  stripePaymentIntentId String?     @unique

  @@index([email])
  @@index([promotionId])
}

model OrderItem {
  id        String  @id @default(cuid())
  amountMxn Int
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
}

model Enrollment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}
